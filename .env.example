# ============================================================
# Telangana Road & Infrastructure Intelligence API Environment Configuration
# ============================================================

# Environment & Server
ENVIRONMENT=production
DEBUG=false
PORT=8000

# Database Configuration (PostgreSQL / PostGIS)
# Production format: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/telangana_road_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache & Distributed Rate Limiting (Optional)
REDIS_URL=redis://localhost:6379/0

# Production Security & Secrets (DO NOT COMMIT REAL SECRETS)
JWT_SECRET=your_custom_production_jwt_signing_secret_here
JWT_EXPIRE_MINUTES=1440
API_KEY=tg_road_intel_secret_key_2026
GEMINI_API_KEY=your_google_gemini_api_key_here
CORS_ORIGINS=https://api.yourdomain.gov.in,https://dashboard.yourdomain.gov.in

# External Source Routing & Endpoints
TELANGANA_GIS_BASE_URL=https://gis.telangana.gov.in/arcgis/rest/services
BHUVAN_GIS_BASE_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/gwc/service/wms
OVERPASS_GIS_BASE_URL=https://overpass-api.de/api/interpreter
TELANGANA_OPEN_DATA_BASE_URL=https://data.telangana.gov.in/api/v1
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
TELANGANA_EPROCUREMENT_URL=https://tender.telangana.gov.in

# Operational & Logging
LOG_LEVEL=INFO
LOG_FORMAT=JSON
MAX_RESEARCH_SOURCES=10
MAX_PAGES_PER_SOURCE=5
MAX_RESPONSE_BYTES=10485760
MAX_GEMINI_CALLS_PER_RESEARCH=5
RESEARCH_TIMEOUT_SECONDS=60
